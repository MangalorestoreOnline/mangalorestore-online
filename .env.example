# ==========================================
# MangaloreStore.Online - Environment Variables
# ==========================================

# 1. Supabase (Database, Auth, Storage)
# Get these from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Razorpay (Payments)
# Get these from Razorpay Dashboard > Settings > API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 3. Resend (Transactional Emails)
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=orders@mangalorestore.online

# 4. App & Domain URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 5. Analytics & Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-NJDDH8QC

# 6. Store Information
NEXT_PUBLIC_STORE_NAME=MangaloreStore.Online
NEXT_PUBLIC_STORE_PHONE=+917975928765
NEXT_PUBLIC_WHATSAPP_NUMBER=9179759287652
NEXT_PUBLIC_SUPPORT_EMAIL=help@mangalorestore.online
